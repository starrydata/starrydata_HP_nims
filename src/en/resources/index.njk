---
layout: modern.njk
permalink: /en/resources/index.html
title: Resources
lang: en
bodyId: resources
---

{%- set L = "en" -%}
{%- set S = i18n.resources_page.sections[L] -%}

<section class="page-head">
  <div class="container">
    <h1 data-echo="{{ i18n.resources_page.title[L] }}">{{ i18n.resources_page.title[L] }}</h1>
    <p class="lead">{{ i18n.resources_page.lead[L] }}</p>
  </div>
</section>

{%- for col in i18n.resources_mega.columns[L] %}
{%- set key = ('explore' if loop.index0 == 0 else ('download' if loop.index0 == 1 else 'docs')) -%}
<section class="section {{ 'section-top-tight' if loop.first else '' }} resources-section" id="{{ key }}">
  <div class="container">
    <div class="resources-section-head">
      <h2>{{ S[key].title }}</h2>
      <p class="resources-section-desc">{{ S[key].desc }}</p>
    </div>

    {%- for item in col.items %}{% if item.featured %}
    <a class="resources-featured-card" href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>
      {% if item.image %}
      <div class="resources-featured-thumb">
        <img src="{{ item.image }}" alt="{{ item.title }}" loading="lazy">
      </div>
      {% endif %}
      <div class="resources-featured-body">
        {% if item.badge %}<span class="resources-featured-badge">{{ item.badge }}</span>{% endif %}
        <h3 class="resources-featured-title">
          {{ item.title }}{% if item.external %} <span class="resources-card-ext" aria-hidden="true">↗</span>{% endif %}
        </h3>
        <p class="resources-featured-desc">{{ item.desc | safe }}</p>
      </div>
    </a>
    {% endif %}{%- endfor %}

    <div class="resources-grid{% if key == 'explore' %} has-thumbs{% endif %}">
      {%- for item in col.items %}{% if not item.featured %}
      <a class="resources-card{% if item.image %} has-thumb{% endif %}" href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>
        {% if item.image %}
        <div class="resources-card-thumb">
          <img src="{{ item.image }}" alt="{{ item.title }}" loading="lazy">
        </div>
        {% else %}
        <div class="resources-card-icon">
          <svg width="24" height="24" aria-hidden="true"><use href="#mm-icon-{{ item.icon }}"/></svg>
        </div>
        {% endif %}
        <div class="resources-card-body">
          <h3 class="resources-card-title">
            {{ item.title }}{% if item.external %} <span class="resources-card-ext" aria-hidden="true">↗</span>{% endif %}
          </h3>
          <p class="resources-card-desc">{{ item.desc | safe }}</p>
        </div>
      </a>
      {% endif %}{%- endfor %}
    </div>
  </div>
</section>
{%- endfor %}

<section class="section resources-section" id="related" style="background:#f7f9ff; border-top:1px solid var(--line);">
  <div class="container">
    <div class="resources-section-head">
      <h2>{{ S.related.title }}</h2>
      <p class="resources-section-desc">{{ S.related.desc }}</p>
    </div>
    <div class="resources-grid has-thumbs">
      <a class="resources-card" href="https://cssim.starrydata.org" target="_blank" rel="noopener">
        <div class="resources-card-thumb">
          <img src="/assets/images/apps/cssim.png" alt="Crystal Structure Simulator" loading="lazy">
        </div>
        <div class="resources-card-body">
          <h3 class="resources-card-title">Crystal Structure Simulator <span class="resources-card-ext" aria-hidden="true">↗</span></h3>
          <p class="resources-card-desc">Interactive simulation and visualization of crystal structures.</p>
        </div>
      </a>
      <a class="resources-card" href="https://erm.starrydata.org" target="_blank" rel="noopener">
        <div class="resources-card-thumb">
          <img src="/assets/images/apps/erm.png" alt="Elemental Reactivity Map" loading="lazy">
        </div>
        <div class="resources-card-body">
          <h3 class="resources-card-title">Elemental Reactivity Map <span class="resources-card-ext" aria-hidden="true">↗</span></h3>
          <p class="resources-card-desc">Visual map of reactivity between elements.</p>
        </div>
      </a>
      <a class="resources-card" href="https://dsxrd.starrydata.org" target="_blank" rel="noopener">
        <div class="resources-card-thumb">
          <img src="/assets/images/apps/dsxrd.png" alt="Debye-Scherrer XRD" loading="lazy">
        </div>
        <div class="resources-card-body">
          <h3 class="resources-card-title">Debye-Scherrer XRD <span class="resources-card-ext" aria-hidden="true">↗</span></h3>
          <p class="resources-card-desc">Generate and visualize Debye-Scherrer X-ray diffraction plots.</p>
        </div>
      </a>
    </div>
  </div>
</section>
