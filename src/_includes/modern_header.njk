{%- set L = lang or 'ja' -%}
{%- set otherLang = 'en' if L == 'ja' else 'ja' -%}
{%- set langPath = '/en/' if L == 'en' else '/' -%}
{%- set otherLangPath = '/en/' if otherLang == 'en' else '/' -%}

{# 言語切替リンクの URL 計算: 現在のページの対応言語版へ飛ばす #}
{# EN 版が存在しないレガシー系のパスは /en/ にフォールバック #}
{%- set jaOnlyPrefixes = ['/manual/', '/data/', '/collaboration/', '/tutorial/', '/faq/', '/topics/', '/utility/', '/project/', '/pages/'] -%}
{%- set isJaOnly = false -%}
{%- for prefix in jaOnlyPrefixes -%}
  {%- if page.url.indexOf(prefix) == 0 -%}{%- set isJaOnly = true -%}{%- endif -%}
{%- endfor -%}

{%- if L == 'en' -%}
  {%- set jaUrl = page.url | replace('/en/', '/') -%}
  {%- set enUrl = page.url -%}
{%- else -%}
  {%- set jaUrl = page.url -%}
  {%- if page.url == '/' -%}
    {%- set enUrl = '/en/' -%}
  {%- elif isJaOnly -%}
    {%- set enUrl = '/en/' -%}
  {%- else -%}
    {%- set enUrl = '/en' + page.url -%}
  {%- endif -%}
{%- endif -%}

{%- set researchPath = '/en/research/' if L == 'en' else '/research/' -%}
{%- set papersPath = '/en/papers/' if L == 'en' else '/papers/' -%}
{%- set contactPath = '/en/contact/' if L == 'en' else '/contact/' -%}
{%- set resourcesPath = '/en/resources/' if L == 'en' else '/resources/' -%}
{%- set teamPath = '/en/team/' if L == 'en' else '/team/' -%}
{%- set newsPath = '/en/news/' if L == 'en' else '/news/' -%}
{%- set aboutPath = langPath + '#about' -%}
{%- set aboutLabel = 'About the project' if L == 'en' else 'プロジェクト概要' -%}
{%- set seeAllLabel = 'View all Resources' if L == 'en' else 'Resources 全体を見る' -%}

<!-- Nav icon sprite (used by the Resources mega-menu) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="mm-icon-search"    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></symbol>
    <symbol id="mm-icon-chart"     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="20" x2="6" y2="14"/><line x1="12" y1="20" x2="12" y2="8"/><line x1="18" y1="20" x2="18" y2="4"/></symbol>
    <symbol id="mm-icon-grid"      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
    <symbol id="mm-icon-globe"     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></symbol>
    <symbol id="mm-icon-file-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><line x1="8" y1="9" x2="10" y2="9"/></symbol>
    <symbol id="mm-icon-edit"      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></symbol>
    <symbol id="mm-icon-package"   viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></symbol>
    <symbol id="mm-icon-bookmark"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></symbol>
    <symbol id="mm-icon-book"      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></symbol>
    <symbol id="mm-icon-quote"     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></symbol>
    <symbol id="mm-icon-book-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></symbol>
    <symbol id="mm-icon-code"      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></symbol>
    <symbol id="mm-icon-layers"    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></symbol>
    <symbol id="mm-icon-hexagon"   viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="21 16 21 8 12 3 3 8 3 16 12 21 21 16"/></symbol>
    <symbol id="mm-icon-map"       viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></symbol>
    <symbol id="mm-icon-activity"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></symbol>
  </defs>
</svg>

<header class="site-header">
  <div class="container">
    <a class="site-logo" href="{{ langPath }}" aria-label="Starrydata">
      <img src="/assets/images/logo/starrydata_logo_wide.png" alt="Starrydata — National Institute for Materials Science" />
    </a>

    <nav class="site-nav" aria-label="Global">
      <div class="site-nav-item has-dropdown" data-dropdown-parent>
        <a class="site-nav-btn" href="{{ aboutPath }}" aria-expanded="false" aria-controls="dropdown-about" aria-haspopup="true">
          {{ i18n.nav.about[L] }}
          <svg class="site-nav-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div id="dropdown-about" class="site-nav-dropdown" hidden data-dropdown-panel>
          <a href="{{ aboutPath }}">{{ aboutLabel }}</a>
          <a href="{{ teamPath }}">{{ i18n.nav.team[L] }}</a>
          <a href="{{ newsPath }}">{{ i18n.nav.news[L] }}</a>
        </div>
      </div>

      <div class="site-nav-item has-mega" data-mega-parent>
        <a class="site-nav-btn" href="{{ resourcesPath }}" aria-expanded="false" aria-controls="mega-resources" aria-haspopup="true">
          {{ i18n.nav.resources[L] }}
          <svg class="site-nav-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <a href="{{ researchPath }}">{{ i18n.nav.research[L] }}</a>
      <a href="{{ papersPath }}">{{ i18n.nav.publications[L] }}</a>
      <a href="{{ contactPath }}">{{ i18n.nav.contact[L] }}</a>
    </nav>

    <span class="lang-switch" role="group" aria-label="Language">
      <a href="{{ jaUrl }}" class="{{ 'is-active' if L == 'ja' else '' }}">JA</a>
      <a href="{{ enUrl }}" class="{{ 'is-active' if L == 'en' else '' }}">EN</a>
    </span>
  </div>

  <!-- Resources mega-menu panel (positioned below header, full page width) -->
  <div id="mega-resources" class="mega-menu" hidden data-mega-panel>
    <div class="mega-menu-inner">
      {%- for col in i18n.resources_mega.columns[L] %}
      <div class="mega-menu-col">
        <div class="mega-menu-col-title">{{ col.title }}</div>
        <ul class="mega-menu-list">
          {%- for item in col.items %}
          <li>
            <a class="mega-menu-link" href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>
              <span class="mega-menu-icon">
                <svg width="20" height="20" aria-hidden="true"><use href="#mm-icon-{{ item.icon }}"/></svg>
              </span>
              <span class="mega-menu-text">
                <span class="mega-menu-title">
                  {{ item.title }}{% if item.external %} <span class="mega-menu-ext" aria-hidden="true">↗</span>{% endif %}
                </span>
                <span class="mega-menu-desc">{{ item.desc | safe }}</span>
              </span>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
    <div class="mega-menu-foot">
      <a class="mega-menu-foot-link" href="{{ resourcesPath }}">→ {{ seeAllLabel }}</a>
    </div>
  </div>
</header>

<script>
(function () {
  // 汎用ヘッダーメニュー開閉 (Resources メガメニュー + About ドロップダウン)
  var menus = [];

  function setupMenu(parent, panel) {
    if (!parent || !panel) return;
    var trigger = parent.querySelector('.site-nav-btn');
    var closeTimer = null;

    function open() {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      panel.hidden = false;
      parent.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    }
    function close() {
      panel.hidden = true;
      parent.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    }
    function scheduleClose() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = setTimeout(close, 180);
    }

    parent.addEventListener('mouseenter', open);
    parent.addEventListener('mouseleave', scheduleClose);
    panel.addEventListener('mouseenter', function () { if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; } });
    panel.addEventListener('mouseleave', scheduleClose);

    menus.push({ parent: parent, panel: panel, trigger: trigger, close: close });
  }

  // Resources メガメニュー: パネルはヘッダー配下 (site-nav-item の外)
  setupMenu(
    document.querySelector('[data-mega-parent]'),
    document.querySelector('[data-mega-panel]')
  );
  // About ドロップダウン: パネルは site-nav-item の内部
  document.querySelectorAll('[data-dropdown-parent]').forEach(function (parent) {
    setupMenu(parent, parent.querySelector('[data-dropdown-panel]'));
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    menus.forEach(function (m) {
      if (!m.panel.hidden) { m.close(); m.trigger.focus(); }
    });
  });

  document.addEventListener('click', function (e) {
    menus.forEach(function (m) {
      if (m.panel.hidden) return;
      if (m.parent.contains(e.target) || m.panel.contains(e.target)) return;
      m.close();
    });
  });
})();
</script>
