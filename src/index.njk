        {% if m.photo %}
        <img class="photo" src="{{ m.photo }}" alt="{{ m.name_ja }}">
        {% else %}
        <div class="photo"></div>
        {% endif %}
        <h4>{{ m.name_ja }}</h4>
        <div class="role">{{ m.role }}</div>
      </div>
      {%- endfor %}
    </div>

    <div class="section-foot">
      <a class="btn btn-outline" href="/members/">{{ i18n.team.see_all[L] }} →</a>
    </div>
  </div>
</section>

