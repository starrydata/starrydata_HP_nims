        <div class="field-num">04</div><h3>Dielectric</h3></a>
      <a class="field-card" href="/research/#condensed-matter">
        <div class="field-num">05</div><h3>Condensed Matter</h3></a>
      <a class="field-card" href="/research/#piezoelectric">
        <div class="field-num">06</div><h3>Piezoelectric</h3></a>
