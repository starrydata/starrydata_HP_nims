---
pagination:
  data: projects.projects
  size: 1
  alias: p
permalink: "/data/{{ p.slug }}.html"
eleventyComputed:
  title: "{{ p.full_title }}"
layout: modern.njk
lang: ja
---

{%- set L = "ja" -%}

<section class="page-head">
  <div class="container">
    <span class="eyebrow">
      <a href="/data/" style="color:inherit; text-decoration:none;">Data</a> / {{ p.card_title }}
    </span>
    <h1>{{ p.full_title }}</h1>
    {% if p.owner %}<p class="lead data-owner-line">{{ p.owner }}</p>{% endif %}
  </div>
</section>

<section class="section section-top-tight">
  <div class="container">

    <div class="data-project-body">
      {{ p.body_html | safe }}
    </div>

    {% if p.figure %}
    <figure class="data-project-figure">
      <img src="{{ p.figure.image }}" alt="{{ p.card_title }}">
      {% if p.figure.caption %}
      <figcaption>{{ p.figure.caption | replace("\n", "<br>") | safe }}</figcaption>
      {% endif %}
    </figure>
    {% endif %}

    <div class="data-project-back">
      <a href="/data/">← データ収集プロジェクト一覧に戻る</a>
    </div>

  </div>
</section>
