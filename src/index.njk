---
layout: modern.njk
permalink: /ja/index.html
title:
lang: ja
---

{%- set L = "ja" -%}

<!-- =================== HERO =================== -->
<section class="hero">
  <div class="container">
    <h1>
      {{ i18n.hero.headline_1[L] | safe }}
      <span class="hero-subtitle">{{ i18n.hero.headline_2[L] | safe }}</span>
    </h1>
    <p class="lead">{{ i18n.hero.subline[L] | safe }}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="{{ site.external.starrydata2 }}" target="_blank" rel="noopener">
        {{ i18n.hero.cta_primary[L] }} →
      </a>
      <a class="btn btn-primary" href="https://starrydata.github.io/starrydata_datasets/" target="_blank" rel="noopener">
        データセットを取得する →
      </a>
    </div>
  </div>
</section>

<!-- =================== STATS =================== -->
<section class="stats">
  <div class="container">
    <div class="stats-detail">
      <div class="stats-donuts" id="stats-donuts"></div>
      <div class="stats-updated" id="stats-updated"></div>
      <div class="stats-table-wrap">
        <table class="stats-table">
          <thead>
            <tr>
              <th class="col-project">Research Field</th>
              <th class="num">Papers</th>
              <th class="num">Figures</th>
              <th class="num">Samples</th>
              <th class="num">Curves</th>
            </tr>
          </thead>
          <tbody id="stats-project-tbody">
            <tr><td colspan="5" class="stats-loading">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- =================== WHAT IS =================== -->
<section class="section section-narrow" id="about">
  <div class="container">
    <h2 data-echo="{{ i18n.what_is.title[L] }}">{{ i18n.what_is.title[L] }}</h2>
    <p class="prose">{{ i18n.what_is.lead[L] | safe }}</p>
    {%- for para in i18n.what_is.body[L] %}
    <p class="prose">{{ para | safe }}</p>
    {%- endfor %}
  </div>
</section>

<!-- =================== PIPELINE DIAGRAM =================== -->
<section class="pipeline-section">
  <div class="container">
    <p class="pipeline-eyebrow">How it works</p>
    <h2 class="pipeline-heading">
      収集<span class="pipe-arrow-char">→</span>蓄積<span class="pipe-arrow-char">→</span>活用
    </h2>
    <p class="pipeline-desc">
      論文の実験グラフを人手でデジタイズし、試料情報とともに登録・蓄積。<br>集まった構造化データは可視化・ダウンロード・機械学習にそのまま使える。
    </p>

    <!-- ラベル行（グリッド外） -->
    <div class="pipeline-col-headers">
      <div class="pipeline-col-label">データ収集・登録</div>
      <div></div>
      <div></div>
      <div class="pipeline-col-label">データ活用</div>
    </div>

    <div class="pipeline-grid">

      <!-- ─── 左：データ収集・登録 ─── -->
      <div class="pipeline-col">
        <div class="pipeline-col-label pipeline-col-label--mobile">データ収集・登録</div>

        <div class="pipe-card pipe-card-in">
          <div class="pipe-card-thumb">
            <img src="/assets/images/pipeline/06-papers-stack.svg" alt="論文選定" loading="lazy">
          </div>
          <div class="pipe-card-body">
            <div class="pipe-card-name">論文選定</div>
            <div class="pipe-card-desc">データ収集対象となる論文・グラフ・プロットを特定</div>
          </div>
        </div>

        <div class="pipe-down-arrow" aria-hidden="true">
          <svg width="14" height="22" viewBox="0 0 14 22" fill="none"><path d="M7 1v16M1 11l6 8 6-8" stroke="var(--accent-2)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3"/></svg>
        </div>

        <div class="pipe-card pipe-card-in">
          <div class="pipe-card-thumb">
            <img src="/assets/images/pipeline/01-pen-tablet-curve-selection.svg" alt="実験グラフを数値化" loading="lazy">
          </div>
          <div class="pipe-card-body">
            <div class="pipe-card-name">実験グラフを数値化</div>
            <div class="pipe-card-desc">StarryDigitizer でグラフのカーブをプロットし数値データ化</div>
          </div>
        </div>

        <div class="pipe-down-arrow" aria-hidden="true">
          <svg width="14" height="22" viewBox="0 0 14 22" fill="none"><path d="M7 1v16M1 11l6 8 6-8" stroke="var(--accent-2)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3"/></svg>
        </div>

        <div class="pipe-card pipe-card-in">
          <div class="pipe-card-thumb">
            <img src="/assets/images/pipeline/02-curator-descriptor-input.svg" alt="Sample Descriptor" loading="lazy">
          </div>
          <div class="pipe-card-body">
            <div class="pipe-card-name">Sample Descriptor 登録</div>
            <div class="pipe-card-desc">組成・合成方法・測定条件を論文本文から記述</div>
          </div>
        </div>
      </div>

      <!-- ─── 中央：DB ─── -->
      <div class="pipeline-center">
        <div class="db-node-wrap">
          <span class="db-open-badge">Open Database</span>
          <img class="db-cluster-svg" src="/assets/images/pipeline/10-database.svg" alt="Starrydata DB">
          <div class="db-node-name">Starrydata DB</div>
          <div class="db-node-sub">カーブ・試料情報・論文情報を保存</div>
        </div>
      </div>

      <!-- ─── DB→右 スペーサー列 ─── -->
      <div class="pipeline-col-arrows" aria-hidden="true"></div>

      <!-- ─── 右：データ活用 ─── -->
      <div class="pipeline-col">
        <div class="pipeline-col-label pipeline-col-label--mobile">データ活用</div>

        <div class="pipe-card pipe-card-out">
          <div class="pipe-card-thumb">
            <img src="/assets/images/pipeline/05-explorer-3d.png" alt="可視化・探索" loading="lazy">
          </div>
          <div class="pipe-card-body">
            <div class="pipe-card-name">可視化・探索</div>
            <div class="pipe-card-desc">Visualizer / Sample Explorer で傾向を把握</div>
          </div>
        </div>

        <div class="pipe-row-spacer" aria-hidden="true"></div>

        <div class="pipe-card pipe-card-out">
          <div class="pipe-card-thumb">
            <img src="/assets/images/pipeline/09-pc.svg" alt="データダウンロード" loading="lazy">
          </div>
          <div class="pipe-card-body">
            <div class="pipe-card-name">データダウンロード</div>
            <div class="pipe-card-desc">CSV / JSON で自由に取得・利用可能</div>
          </div>
        </div>

        <div class="pipe-row-spacer" aria-hidden="true"></div>

        <div class="pipe-card pipe-card-out">
          <div class="pipe-card-thumb">
            <img src="/assets/images/pipeline/starrydata-ml-mi.svg" alt="機械学習・MI研究" loading="lazy">
          </div>
          <div class="pipe-card-body">
            <div class="pipe-card-name">機械学習・MI 研究</div>
            <div class="pipe-card-desc">構造化データを学習・ベンチマークに活用</div>
          </div>
        </div>
      </div>

      <!-- DB→右カード矢印SVG（グリッド全体に重ねる） -->
      <svg class="pipe-arrows-svg" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"></svg>

    </div><!-- /.pipeline-grid -->
  </div>
</section>
<script>
(function(){
  function drawPipeArrows(){
    var grid = document.querySelector('.pipeline-grid');
    if(!grid) return;
    var svg = grid.querySelector('.pipe-arrows-svg');
    var db  = document.querySelector('.db-node-wrap');
    var cards = Array.prototype.slice.call(document.querySelectorAll('.pipe-card-out'));
    if(!svg||!db||!cards.length) return;
    var gR = grid.getBoundingClientRect();
    var dbR = db.getBoundingClientRect();
    var dbY = dbR.top + dbR.height/2 - gR.top;
    var forkX = dbR.right - gR.left;
    var clr = '#9184d9';
    var lAttr = 'fill="none" stroke="'+clr+'" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3"';
    var sAttr = 'fill="none" stroke="'+clr+'" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';
    var inner = '';
    for(var i=0;i<cards.length;i++){
      var r = cards[i].getBoundingClientRect();
      var cy = r.top + r.height/2 - gR.top;
      var cx = r.left - gR.left;
      inner += '<line x1="'+forkX.toFixed(1)+'" y1="'+dbY.toFixed(1)+'" x2="'+cx.toFixed(1)+'" y2="'+cy.toFixed(1)+'" '+lAttr+'/>';
      var dx = cx-forkX, dy = cy-dbY, len = Math.sqrt(dx*dx+dy*dy);
      var ux = dx/len, uy = dy/len;
      var ax = cx-7*ux, ay = cy-7*uy;
      inner += '<path d="M'+(ax-4*uy).toFixed(1)+','+(ay+4*ux).toFixed(1)+' L'+cx.toFixed(1)+','+cy.toFixed(1)+' L'+(ax+4*uy).toFixed(1)+','+(ay-4*ux).toFixed(1)+'" '+sAttr+'/>';
    }
    svg.setAttribute('width', gR.width);
    svg.setAttribute('height', gR.height);
    svg.innerHTML = inner;
  }
  window.addEventListener('load', drawPipeArrows);
  window.addEventListener('resize', drawPipeArrows);
})();
</script>

<!-- =================== HUGE DATABASE =================== -->
<section class="section" id="huge-database" style="background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div class="container">
    <div class="grid-2col">
      <div class="text-col">
        <h2 data-echo="{{ i18n.huge_db.title[L] }}">{{ i18n.huge_db.title[L] }}</h2>
        <p class="lead">
          一本の論文だけでは見えない全体像が、数万件のサンプルとカーブを横断して眺めることで初めて浮かび上がります。
        </p>
        <p class="prose">
          材料系ごとの性能分布、組成と物性の相関、外れ値や未探索の組成空間の可視化、そして機械学習モデルの学習・ベンチマーク用データセットとして──大規模データベースだからこそ可能な使い方があります。
        </p>
        <div class="hero-ctas" style="margin-top:28px;">
          <a class="btn btn-primary" href="{{ site.external.starrydata2 }}" target="_blank" rel="noopener">{{ i18n.huge_db.cta[L] }}</a>
        </div>
      </div>
      <div class="chart-col">
        <div id="chart-temp-seebeck" style="width:100%;height:520px;"></div>
        <p class="chart-meta" id="chart-temp-seebeck-meta">Loading…</p>
      </div>
    </div>
  </div>
</section>

<!-- =================== データ利用ガイド (Resources) =================== -->
<section class="section" id="resources">
  <div class="container">
    <h2 data-echo="{{ i18n.resources_page.title[L] }}">{{ i18n.resources_page.title[L] }}</h2>
    <p class="lead">目的に応じてツールを選んで、Starrydata のデータを活用してください。</p>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="tnav-icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></symbol>
        <symbol id="tnav-icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></symbol>
        <symbol id="tnav-icon-chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="20" x2="6" y2="14"/><line x1="12" y1="20" x2="12" y2="8"/><line x1="18" y1="20" x2="18" y2="4"/></symbol>
        <symbol id="tnav-icon-grid" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
      </defs>
    </svg>

    <h3 class="home-resources-sub">{{ i18n.task_nav.title[L] }}</h3>
    <div class="task-nav-grid">
      {%- for c in i18n.task_nav.cards[L] %}
      <a class="task-nav-card" href="{{ c.url }}" target="_blank" rel="noopener">
        <div class="task-nav-icon">
          <svg width="26" height="26" aria-hidden="true"><use href="#tnav-icon-{{ c.icon_key }}"/></svg>
        </div>
        <div class="task-nav-system">{{ c.system }}</div>
        <h4>{{ c.title }}</h4>
        <p>{{ c.desc }}</p>
      </a>
      {%- endfor %}
    </div>

    <a class="home-resources-cta" href="/resources/">
      <div class="home-resources-cta-body">
        <div class="home-resources-cta-eyebrow">Resources</div>
        <h3>すべてのツールとドキュメントを見る</h3>
        <p>Starrydata2 Web System(データの登録・検索・ダウンロード)、Visualizer / Sample Explorer などの可視化・組成検索ツール、Figshare のデータセットスナップショット、Manual・データ仕様・引用情報を目的別にまとめています。</p>
      </div>
      <div class="home-resources-cta-arrow" aria-hidden="true">→</div>
    </a>
  </div>
</section>

