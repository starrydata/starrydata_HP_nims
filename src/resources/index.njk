---
layout: modern.njk
permalink: /resources/index.html
title: データ利用ガイド
lang: ja
bodyId: resources
---

{%- set L = "ja" -%}
{%- set S = i18n.resources_page.sections[L] -%}

<section class="page-head">
  <div class="container">
    <h1 data-echo="{{ i18n.resources_page.title[L] }}">{{ i18n.resources_page.title[L] }}</h1>
    <p class="lead">{{ i18n.resources_page.lead[L] }}</p>
  </div>
</section>

{%- for col in i18n.resources_mega.columns[L] %}
{%- set key = ('explore' if loop.index0 == 0 else ('download' if loop.index0 == 1 else 'docs')) -%}
<section class="section {{ 'section-top-tight' if loop.first else '' }} resources-section" id="{{ key }}">
  <div class="container">
    <div class="resources-section-head">
      <h2>{{ S[key].title }}</h2>
      <p class="resources-section-desc">{{ S[key].desc }}</p>
    </div>
    <div class="resources-grid">
      {%- for item in col.items %}
      <a class="resources-card" href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>
        <div class="resources-card-icon">
          <svg width="24" height="24" aria-hidden="true"><use href="#mm-icon-{{ item.icon }}"/></svg>
        </div>
        <div class="resources-card-body">
          <h3 class="resources-card-title">
            {{ item.title }}{% if item.external %} <span class="resources-card-ext" aria-hidden="true">↗</span>{% endif %}
          </h3>
          <p class="resources-card-desc">{{ item.desc }}</p>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endfor %}

<section class="section resources-section" id="related" style="background:#f7f9ff; border-top:1px solid var(--line);">
  <div class="container">
    <div class="resources-section-head">
      <h2>{{ S.related.title }}</h2>
      <p class="resources-section-desc">{{ S.related.desc }}</p>
    </div>
    <ul class="resources-related-list">
      <li>
        <a href="/data/">
          <strong>進行中のデータ収集プロジェクト</strong>
          <span>ThermoelectricMaterials / Magnetic / Battery など、分野ごとの収集内容と担当者 →</span>
        </a>
      </li>
      <li>
        <a href="/#apps">
          <strong>その他の Materials Informatics ツール</strong>
          <span>Crystal Structure Simulator / Elemental Reactivity Map / Debye-Scherrer XRD (トップページ Apps & Systems へ) →</span>
        </a>
      </li>
      <li>
        <a href="/contact/">
          <strong>質問・要望</strong>
          <span>データや機能のリクエストは Contact ページから →</span>
        </a>
      </li>
    </ul>
  </div>
</section>
