---
layout: modern.njk
permalink: /use/index.html
title: Use Data
lang: ja
---

{%- set L = "ja" -%}
{%- set U = i18n.use_page -%}

<section class="page-head">
  <div class="container">
    <span class="eyebrow">{{ U.eyebrow[L] }}</span>
    <h1>{{ U.title[L] }}</h1>
    <p class="lead">{{ U.lead[L] }}</p>
  </div>
</section>

<section class="section section-top-tight">
  <div class="container">
    <div class="use-cards">
      {%- for c in U.cards[L] %}
      <a class="use-card"
         href="{{ c.url }}"
         {% if c.external %}target="_blank" rel="noopener"{% endif %}>
        <span class="use-card-eyebrow">{{ c.eyebrow }}</span>
        <h2 class="use-card-title">{{ c.title }}</h2>
        <p class="use-card-desc">{{ c.desc }}</p>
        <span class="use-card-cta">
          {{ c.cta }}
          {% if c.external %}↗{% else %}→{% endif %}
        </span>
      </a>
      {%- endfor %}
    </div>

    <div class="use-cite">
      <h2 class="use-cite-title">{{ U.cite_title[L] }}</h2>
      <p class="use-cite-body">{{ U.cite_body[L] }}</p>
      <p class="use-cite-ref">{{ U.cite_ref[L] | safe }}</p>
    </div>
  </div>
</section>
