---
layout: modern.njk
permalink: /publications/index.html
title: Publications
lang: en
---

{%- set L = "en" -%}

<section class="page-head">
  <div class="container">
    <h1 data-echo="{{ i18n.papers_page.title[L] }}">{{ i18n.papers_page.title[L] }}</h1>
    <p class="lead">{{ i18n.papers_page.lead[L] | safe }}</p>
    <p class="papers-source">
      Sources:
      <a href="https://openalex.org" target="_blank" rel="noopener">OpenAlex</a>
      ／
      <a href="https://opencitations.net" target="_blank" rel="noopener">OpenCitations</a>
      ／
      Last fetched: <time datetime="{{ papers.fetched_at }}">{{ papers.fetched_at.substring(0, 10) }}</time>
    </p>
  </div>
</section>

<section class="section section-top-tight" id="project-papers">
  <div class="container">
    <h2 class="papers-h2">
      Project papers
      <span class="count">{{ papers.project_papers_count }}</span>
    </h2>
    <p class="papers-note">Representative publications by Yukari Katsura and the Starrydata team (managed via a seed DOI list).</p>

    <ol class="paper-list">
      {%- for p in papers.project_papers %}
      <li class="paper-item">
        <div class="paper-year-col">{{ p.year }}</div>
        <div class="paper-body">
          <p class="paper-title">
            {%- if p.work_type %}
            <span class="type-badge type-{{ p.work_type }}">{{ p.work_type | capitalize | replace("-", " ") }}</span>
            {%- endif %}
            {%- if p.doi_url %}
            <a href="{{ p.doi_url }}" target="_blank" rel="noopener">{{ p.title }}</a>
            {%- else %}
            {{ p.title }}
            {%- endif %}
          </p>
          {%- if p.authors %}<p class="paper-authors">{{ p.authors }}</p>{% endif %}
          <p class="paper-meta">
            {%- if p.journal %}<em class="journal">{{ p.journal }}</em>{% endif %}
            {%- if p.volume %} <strong>{{ p.volume }}</strong>{% endif %}
            {%- if p.issue %} [{{ p.issue }}]{% endif %}
            {%- if p.start_page %}, {{ p.start_page }}{% if p.end_page %}–{{ p.end_page }}{% endif %}{% endif %}
          </p>
          {%- if p.doi %}
          <p class="paper-doi">DOI: <a href="{{ p.doi_url }}" target="_blank" rel="noopener">{{ p.doi }}</a></p>
          {%- endif %}
          {%- if p.cited_by_count %}
          <p class="paper-citations">
            <span class="citation-pill">Cited by <strong>{{ p.cited_by_count }}</strong>{% if p.cited_by_source == "crossref" %} (Crossref){% endif %}</span>
          </p>
          {%- endif %}
        </div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section section-top-tight" id="citation-map-section" style="background:#fff; border-top:1px solid var(--line);">
  <div class="container">
    <h2 class="papers-h2">
      Geographic distribution of citing papers
      <span class="count">{{ papers.citations_by_country | length }}</span>
    </h2>
    <p class="papers-note">
      Aggregated from author affiliations of papers citing Starrydata. Papers with co-authors from multiple countries are counted once per country.
      Country info available for {{ papers.citing_papers_with_country_count }} / {{ papers.citing_papers_count }} papers.
    </p>
    <div id="citation-map" class="citation-map"></div>
  </div>
</section>

{%- macro renderPaperItem(p) %}
        <li class="paper-item paper-item-compact{% if p.usage_tier == 'heavy' %} paper-item-heavy{% endif %}">
          <div class="paper-body">
            <p class="paper-title">
              {%- if p.usage_tier == "heavy" %}<span class="starry-badge" title="Actively using Starrydata">★</span>{% endif %}
              {%- if p.work_type %}
              <span class="type-badge type-{{ p.work_type }}">{{ p.work_type | capitalize | replace("-", " ") }}</span>
              {%- endif %}
              {%- if p.doi_url %}
              <a href="{{ p.doi_url }}" target="_blank" rel="noopener">{{ p.title }}</a>
              {%- else %}
              {{ p.title }}
              {%- endif %}
            </p>
            {%- if p.authors %}<p class="paper-authors">{{ p.authors }}</p>{% endif %}
            <p class="paper-meta">
              {%- if p.journal %}<em class="journal">{{ p.journal }}</em>{% endif %}
              {%- if p.volume %} <strong>{{ p.volume }}</strong>{% endif %}
              {%- if p.issue %} [{{ p.issue }}]{% endif %}
              {%- if p.start_page %}, {{ p.start_page }}{% if p.end_page %}–{{ p.end_page }}{% endif %}{% endif %}
              {%- if p.mentions_starrydata %} · <span class="cites-count" title="mentions &quot;starrydata&quot; in text">mentions Starrydata</span>{% endif %}
              {%- if p.cites_seeds | length >= 2 %} · <span class="cites-count">cites {{ p.cites_seeds | length }} Starrydata papers</span>{% endif %}
            </p>
            {%- if p.doi %}
            <p class="paper-doi">DOI: <a href="{{ p.doi_url }}" target="_blank" rel="noopener">{{ p.doi }}</a></p>
            {%- endif %}
          </div>
        </li>
{%- endmacro %}

<section class="section" id="heavy-papers" style="background:#fffbeb; border-top:1px solid var(--line);">
  <div class="container">
    <h2 class="papers-h2">
      <span class="starry-badge" style="font-size:1em;">★</span>
      Papers actively using Starrydata
      <span class="count">{{ papers.heavy_papers_count }}</span>
    </h2>
    <p class="papers-note">
      Papers matching any of:<br>
      (a) explicitly mention "Starrydata" in the full text (figshare dataset users, system name references)<br>
      (b) cite two or more Starrydata project publications<br>
      (c) manually whitelisted
    </p>

    {%- if papers.heavy_papers_by_year %}
    {%- for group in papers.heavy_papers_by_year %}
    <details class="year-group" open>
      <summary class="year-summary">
        <span class="year-label">{{ group.year or 'Year unknown' }}</span>
        <span class="year-count">{{ group.count }} papers</span>
      </summary>
      <ol class="paper-list">
        {%- for p in group.papers %}{{ renderPaperItem(p) }}{% endfor %}
      </ol>
    </details>
    {%- endfor %}
    {%- else %}
    <p class="papers-note">No papers in this category yet.</p>
    {%- endif %}
  </div>
</section>

<section class="section" id="citing-papers" style="background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div class="container">
    <h2 class="papers-h2">
      Other citing papers
      <span class="count">{{ papers.regular_papers_count }}</span>
    </h2>
    <p class="papers-note">
      Papers citing one Starrydata project publication (newest first).<br>
      Sources: OpenAlex only {{ papers.citing_papers_by_source.openalex_only }} ／
      OpenCitations only {{ papers.citing_papers_by_source.opencitations_only }} ／
      both {{ papers.citing_papers_by_source.both }}
    </p>

    {%- for group in papers.regular_papers_by_year %}
    <details class="year-group" {% if loop.first %}open{% endif %}>
      <summary class="year-summary">
        <span class="year-label">{{ group.year or 'Year unknown' }}</span>
        <span class="year-count">{{ group.count }} papers</span>
      </summary>
      <ol class="paper-list">
        {%- for p in group.papers %}{{ renderPaperItem(p) }}{% endfor %}
      </ol>
    </details>
    {%- endfor %}
  </div>
</section>

<script>window.__citationMapData = {{ papers.citations_by_country | dump | safe }};</script>
<script src="/assets/js/citation-map.js" defer></script>
