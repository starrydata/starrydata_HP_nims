{%- set cc = currentChapter or 0 -%}
{%- set isEn = (lang == 'en') -%}
{%- set base = '/en/manual/' if isEn else '/manual/' -%}
<nav class="manual-chapter-nav" aria-label="Manual chapters">
  <div class="manual-chapter-nav-inner">
    <ul>
      <li{% if cc == 0 %} class="is-current"{% endif %}>
        <a href="{{ base }}">{{ 'Contents' if isEn else '目次' }}</a>
      </li>
      <li{% if cc == 1 %} class="is-current"{% endif %}>
        <a href="{{ base }}account/"><span class="ch">Ch.1</span> {{ 'Account' if isEn else 'アカウント' }}</a>
      </li>
      <li{% if cc == 2 %} class="is-current"{% endif %}>
        <a href="{{ base }}search/"><span class="ch">Ch.2</span> {{ 'Search &amp; Browse' if isEn else '検索・閲覧' }}</a>
      </li>
      <li{% if cc == 3 %} class="is-current"{% endif %}>
        <a href="{{ base }}register/"><span class="ch">Ch.3</span> {{ 'Curation' if isEn else 'データ登録' }}</a>
      </li>
      <li{% if cc == 4 %} class="is-current"{% endif %}>
        <a href="{{ base }}download/"><span class="ch">Ch.4</span> {{ 'Download' if isEn else 'ダウンロード' }}</a>
      </li>
    </ul>
  </div>
</nav>
