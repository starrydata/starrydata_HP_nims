<!DOCTYPE html>
<html lang="{{ lang or 'ja' }}">
<head prefix="og: http://ogp.me/ns#">
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="FOLLOW,INDEX">

{%- set L = lang or 'ja' -%}
{%- set siteName = i18n.site.name[L] -%}
{%- set siteTagline = i18n.site.tagline[L] -%}
{%- set siteDesc = i18n.site.description[L] -%}

{%- set pageTitle = (siteName + ' — ' + title) if title else (siteName + ' — ' + siteTagline) -%}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description or siteDesc }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;800&display=swap" rel="stylesheet">
<link href="/common/css/modern.css" rel="stylesheet">

<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:type" content="website">
<meta property="og:description" content="{{ description or siteDesc }}">
<meta property="og:locale" content="{{ 'ja_JP' if L == 'ja' else 'en_US' }}">
{%- if pathPrefix == '/hp/' -%}
{%- set canonicalPath = '/' if page.url == '/' else ('/hp' + page.url) -%}
<link rel="canonical" href="https://starrydata.nims.go.jp{{ canonicalPath }}">
{%- elif pathPrefix == '/starrydata_HP_nims/' -%}
<meta name="robots" content="noindex, follow">
{%- endif -%}
</head>
<body class="{% if page.url == '/' or page.url == '/ja/' %}page-home{% endif %}{% if bodyId %} page-{{ bodyId }}{% endif %}">

{% include "modern_header.njk" %}

<main>
{{ content | safe }}
</main>

{% include "modern_footer.njk" %}

<!-- Plotly.js (チャート用、遅延読み込み) -->
<script>
(function() {
  // チャート要素があるページのみ Plotly.js を読み込む
  if (!document.getElementById('chart-temp-seebeck')) return;
  const s = document.createElement('script');
  s.src = 'https://cdn.plot.ly/plotly-2.35.2.min.js';
  s.async = true;
  s.onload = () => drawTempSeebeck();
  document.head.appendChild(s);
})();

async function drawTempSeebeck() {
  try {
    const res = await fetch('/data/chart_temp_seebeck.json', { cache: 'no-store' });
    const d = await res.json();

    // visualize_all.py の plotly_dark 風の見た目をそのまま使う
    // figure: { data: [...], layout: {...} }（Plotly Express 出力）
    const config = {
      displaylogo: false,
      responsive: true,
      modeBarButtonsToRemove: ['lasso2d', 'select2d'],
    };
    Plotly.newPlot(
      'chart-temp-seebeck',
      d.figure.data,
      d.figure.layout,
      config
    );

    const meta = document.getElementById('chart-temp-seebeck-meta');
    if (meta) {
      const date = (d.fetched_at || '').substring(0, 10);
      meta.textContent =
        `Source: Starrydata snapshot${d.snapshot ? ' ' + d.snapshot : ''}` +
        ` ／ ${d.point_count.toLocaleString('en-US')} points, ` +
        `${(d.composition_count || 0).toLocaleString('en-US')} compositions` +
        ` ／ Fetched ${date}`;
    }
  } catch (e) {
    console.warn('chart load failed', e);
    const meta = document.getElementById('chart-temp-seebeck-meta');
    if (meta) meta.textContent = 'Chart data temporarily unavailable.';
  }
}
</script>

<script>
(function() {
  // counts.json から最新の Starrydata2 統計を取得
  // https://starrydata.github.io/json/counts.json （Starrydata 公式集計）
  const els = document.querySelectorAll('[data-counts]');
  if (!els.length) return;

  const fmt = n => n.toLocaleString('en-US');

  fetch('https://starrydata.github.io/json/counts.json', { cache: 'no-store' })
    .then(r => r.json())
    .then(d => {
      const fieldsCount = Object.keys(d.projects || {}).filter(k => k !== 'GeneralDB').length || null;
      const map = {
        samples: d.samples,
        curves:  d.curves,
        papers:  d.papers,
        figures: d.figures,
        fields:  fieldsCount,
      };
      els.forEach(el => {
        const key = el.dataset.counts;
        const v = map[key];
        if (v == null) return;
        el.textContent = fmt(v);
      });
    })
    .catch(err => {
      // フォールバックは HTML 内のハードコード値を維持
      console.warn('counts.json fetch failed; using fallback values', err);
    });
})();
</script>

<script>
// Stats detail: ドーナツ + プロジェクト別テーブル
// トップページの stats-donuts / stats-project-tbody 要素があるときのみ動作。
// データソースは /links/ と同じ manifest.json (分野別カウント込み)。
(function () {
  var donutsEl = document.getElementById('stats-donuts');
  var tbodyEl  = document.getElementById('stats-project-tbody');
  var updatedEl = document.getElementById('stats-updated');
  if (!donutsEl || !tbodyEl) return;

  var PIE_COLORS = [
    '#a78bfa', '#818cf8', '#60a5fa', '#22d3ee', '#34d399',
    '#facc15', '#fb923c', '#f472b6', '#c084fc', '#38bdf8', '#4ade80',
    '#e879f9', '#fbbf24'
  ];

  // "PascalCase" → "Words" (GeneralDB → General DB)
  var prettyName = function (name) {
    return name.replace(/([a-z])([A-Z])/g, '$1 $2');
  };

  function drawDonut(canvas, entries, total) {
    var ctx = canvas.getContext('2d');
    var parent = canvas.parentElement;
    var size = Math.min(180, parent.clientWidth - 8);
    var dpr = window.devicePixelRatio || 1;
    canvas.width = size * dpr;
    canvas.height = size * dpr;
    canvas.style.width = size + 'px';
    canvas.style.height = size + 'px';
    ctx.scale(dpr, dpr);

    var cx = size / 2, cy = size / 2, r = size / 2 - 4;
    var startAngle = -Math.PI / 2;

    for (var i = 0; i < entries.length; i++) {
      var slice = (entries[i].value / total) * Math.PI * 2;
      if (slice <= 0) continue;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, r, startAngle, startAngle + slice);
      ctx.closePath();
      ctx.fillStyle = PIE_COLORS[i % PIE_COLORS.length];
      ctx.fill();
      startAngle += slice;
    }
    // 中央くり抜き（Hero 背景色に近い濃紺）
    ctx.beginPath();
    ctx.arc(cx, cy, r * 0.58, 0, Math.PI * 2);
    ctx.fillStyle = '#141031';
    ctx.fill();
    // 中央に total
    ctx.fillStyle = '#e2e8f0';
    ctx.font = 'bold ' + Math.max(11, size * 0.12) + 'px -apple-system, "Inter", sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(total.toLocaleString('en-US'), cx, cy);
  }

  function sortedProjectEntries(projects) {
    var entries = Object.entries(projects);
    var isBattery = function (n) { return /Battery/.test(n); };
    var batCurves = entries.filter(function (e) { return isBattery(e[0]); })
                           .map(function (e) { return e[1].curves || 0; });
    var anchor = batCurves.length ? Math.max.apply(null, batCurves) : -Infinity;
    var keyOf = function (e) { return isBattery(e[0]) ? anchor : (e[1].curves || 0); };
    return entries.sort(function (a, b) {
      var d = keyOf(b) - keyOf(a);
      return d !== 0 ? d : (b[1].curves || 0) - (a[1].curves || 0);
    });
  }

  function renderDonuts(entries, totals) {
    var metrics = [
      { key: 'papers',  title: 'Papers',  total: totals.papers  || 0 },
      { key: 'figures', title: 'Figures', total: totals.figures || 0 },
      { key: 'samples', title: 'Samples', total: totals.samples || 0 },
      { key: 'curves',  title: 'Curves',  total: totals.curves  || 0 }
    ];
    var html = '';
    metrics.forEach(function (m) {
      html += '<div class="stats-donut-card"><h4>' + m.title + '</h4>' +
              '<canvas id="stats-donut-' + m.key + '"></canvas></div>';
    });
    donutsEl.innerHTML = html;
    metrics.forEach(function (m) {
      var data = entries.map(function (e) {
        return { label: prettyName(e[0]), value: e[1][m.key] || 0 };
      }).filter(function (d) { return d.value > 0; });
      drawDonut(document.getElementById('stats-donut-' + m.key), data, m.total);
    });
  }

  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];
    });
  }

  function renderTable(entries, totals) {
    var html = '';
    for (var i = 0; i < entries.length; i++) {
      var name = entries[i][0], v = entries[i][1];
      var color = PIE_COLORS[i % PIE_COLORS.length];
      html += '<tr>' +
        '<td><div class="project-cell"><span class="project-dot" style="background:' + color + ';color:' + color + '"></span>' + esc(prettyName(name)) + '</div></td>' +
        '<td class="num">' + (v.papers  || 0).toLocaleString('en-US') + '</td>' +
        '<td class="num">' + (v.figures || 0).toLocaleString('en-US') + '</td>' +
        '<td class="num">' + (v.samples || 0).toLocaleString('en-US') + '</td>' +
        '<td class="num">' + (v.curves  || 0).toLocaleString('en-US') + '</td>' +
      '</tr>';
    }
    html += '<tr class="total-row">' +
      '<td>Total</td>' +
      '<td class="num">' + (totals.papers  || 0).toLocaleString('en-US') + '</td>' +
      '<td class="num">' + (totals.figures || 0).toLocaleString('en-US') + '</td>' +
      '<td class="num">' + (totals.samples || 0).toLocaleString('en-US') + '</td>' +
      '<td class="num">' + (totals.curves  || 0).toLocaleString('en-US') + '</td>' +
    '</tr>';
    tbodyEl.innerHTML = html;
  }

  // 12 秒でタイムアウトさせて Loading… のまま固まるのを防ぐ
  function fetchWithTimeout(url, opts, ms) {
    return Promise.race([
      fetch(url, opts),
      new Promise(function (_, reject) {
        setTimeout(function () { reject(new Error('timeout')); }, ms);
      })
    ]);
  }

  fetchWithTimeout('https://starrydata.github.io/starrydata_datasets/manifest.json', { cache: 'no-store' }, 12000)
    .then(function (r) { return r.json(); })
    .then(function (manifest) {
      var totals = manifest.totals || {};
      var projects = {};
      Object.entries(manifest.projects || {}).forEach(function (e) {
        projects[e[0]] = (e[1] && e[1].counts) || {};
      });
      var entries = sortedProjectEntries(projects);
      renderDonuts(entries, totals);
      renderTable(entries, totals);

      // db_snapshot: "2026-07-17 16:58:34 UTC+0900 (JST)"
      if (updatedEl && manifest.db_snapshot) {
        var m = String(manifest.db_snapshot).match(/(\d{4})-(\d{2})-(\d{2})/);
        if (m) updatedEl.textContent = 'Dataset: ' + m[1] + '/' + m[2] + '/' + m[3] + ' update';
      }
    })
    .catch(function (err) {
      console.warn('manifest.json fetch failed', err);
      donutsEl.innerHTML = '<p class="stats-loading">Statistics are temporarily unavailable. Open the database for current records.</p>';
      tbodyEl.innerHTML = '<tr><td colspan="5" class="stats-loading">Statistics are temporarily unavailable.</td></tr>';
      if (updatedEl) updatedEl.textContent = '';
    });
})();
</script>
</body>
</html>
